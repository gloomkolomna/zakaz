const money = (n) => n.toLocaleString('ru-RU') + ' ₽';

const CROSS = (size = 12, color = 'currentColor', w = 2) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.4 3.4 12.6 12.6M12.6 3.4 3.4 12.6" stroke="${color}" stroke-width="${w}" stroke-linecap="round" fill="none"/></svg>`;

const CHEVRON = `<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const CHECK = `<svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true" class="check-mark"><path d="M12 30l12 12 20-26" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>`;

const CHEV_UP = `<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const CHEV_DOWN = `<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const MENU_ICON = `<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`;

function rng(seed) {
  let s = seed >>> 0;
  return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
}

function chartArt(o) {
  const cols = o.cols || 18;
  const rows = o.rows || 24;
  const cell = 10;
  const w = cols * cell;
  const h = rows * cell;
  const palette = o.palette || ['#c97b84'];
  const bg = o.bg || '#ffffff';
  const done = o.done || 0.55;
  const r = rng(o.seed || 7);
  const stitch = (x, y, c) =>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>`<rect x="${x * cell + 2.5}" y="${y * cell + 2.5}" width="${cell - 5}" height="${cell - 5}" fill="${c}"/>`;

  let cells = '';
  for (let y = 0; y < rows; y++) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>const t = y / rows;
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>const cut = t < done ? cols : Math.max(0, Math.round(cols * (1 - (t - done) / (1 - done))));
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>const hue = palette[Math.floor(y / 3) % palette.length];
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>for (let x = 0; x < cut; x++) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  if (r() > 0.04) cells += stitch(x, y, hue);
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>}
  }

  if (!o.frame) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>for (let x = 1; x < cols - 1; x += 2) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  cells += stitch(x, 1, palette[2] || palette[0]) + stitch(x, rows - 2, palette[2] || palette[0]);
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>for (let y = 1; y < rows - 1; y += 2) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  cells += stitch(1, y, palette[2] || palette[0]) + stitch(cols - 2, y, palette[2] || palette[0]);
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>}
  }

  let d = '';
  for (let x = 1; x < cols; x++) d += `M${x * cell} 0V${h}`;
  for (let y = 1; y < rows; y++) d += `M0 ${y * cell}H${w}`;
  const frame = o.frame
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>? `<rect x="4" y="4" width="${w - 8}" height="${h - 8}" fill="none" stroke="${o.frame}" stroke-width="8"/>`
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>: '';
  return `<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Вышитый трекер на канве">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><rect width="${w}" height="${h}" fill="${bg}"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><path d="${d}" stroke="#e7e8e0" stroke-width="1" fill="none"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${cells}${frame}
  </svg>`;
}
function hoopArt() {
  return `<svg viewBox="0 0 120 120" role="img" aria-label="Пяльцы">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><rect width="120" height="120" fill="#ffffff"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><circle cx="60" cy="64" r="40" fill="#fdfdf9" stroke="#8b6e4e" stroke-width="8"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><rect x="52" y="12" width="16" height="12" rx="3" fill="#9aa0a6" stroke="#1a201b" stroke-width="1.4"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><path d="M54 24h12" stroke="#8b6e4e" stroke-width="6" stroke-linecap="round"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><path d="M42 58h36M42 70h24" stroke="#c97b84" stroke-width="5" stroke-linecap="round"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><path d="M48 48h20" stroke="#7c9a6d" stroke-width="5" stroke-linecap="round"/>
  </svg>`;
}

function needlesArt() {
  return `<svg viewBox="0 0 120 120" role="img" aria-label="Набор игл">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><rect width="120" height="120" fill="#ffffff"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><g stroke="#9aa0a6" stroke-width="2.4" stroke-linecap="round">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <path d="M34 86 82 38"/><path d="M46 94 94 46"/><path d="M22 78 70 30"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></g>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><g fill="none" stroke="#9aa0a6" stroke-width="1.6">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <ellipse cx="78" cy="42" rx="2.2" ry="4.6" transform="rotate(-45 78 42)"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <ellipse cx="90" cy="50" rx="2.2" ry="4.6" transform="rotate(-45 90 50)"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <ellipse cx="66" cy="34" rx="2.2" ry="4.6" transform="rotate(-45 66 34)"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></g>
  </svg>`;
}

function boxArt() {
  return `<svg viewBox="0 0 120 120" role="img" aria-label="Крафт-коробка">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><rect width="120" height="120" fill="#ffffff"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><rect x="28" y="44" width="64" height="48" fill="#efe3cf" stroke="#1a201b" stroke-width="1.5"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><rect x="24" y="34" width="72" height="12" fill="#e3d3b8" stroke="#1a201b" stroke-width="1.5"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><path d="M60 44v48" stroke="#b02a21" stroke-width="2"/>
  </svg>`;
}

function ribbonArt() {
  return `<svg viewBox="0 0 120 120" role="img" aria-label="Лента">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><rect width="120" height="120" fill="#ffffff"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><path d="M60 58c-12-12-26-10-26 2s14 14 26 2" fill="#f7e8e5" stroke="#b02a21" stroke-width="1.8"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><path d="M60 58c12-12 26-10 26 2s-14 14-26 2" fill="#f7e8e5" stroke="#b02a21" stroke-width="1.8"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><path d="M60 62c0 10-6 18-14 24M60 62c0 10 6 18 14 24" fill="none" stroke="#b02a21" stroke-width="1.8"/>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><circle cx="60" cy="60" r="3.4" fill="#b02a21"/>
  </svg>`;
}

function art(a) {
  if (a.type === 'chart') return chartArt(a);
  if (a.type === 'hoop') return hoopArt();
  if (a.type === 'needles') return needlesArt();
  if (a.type === 'box') return boxArt();
  if (a.type === 'ribbon') return ribbonArt();
  return '';
}

const ROSE = ['#c97b84', '#d99aa0', '#7c9a6d', '#d3a23f'];
const NIGHT = ['#4f7c86', '#8d6a86', '#d3a23f', '#3c5a63'];
const WARM = ['#d3a23f', '#c97b84', '#7c9a6d', '#b07a4a'];
const COOL = ['#8d6a86', '#4f7c86', '#c97b84', '#7c9a6d'];

function simpleSteps(id, price, size, palette, bg) {
  return [
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>{
