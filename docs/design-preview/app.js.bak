    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  items: [{ card: 'c102', qty: 1 }, { card: 'c303', qty: 1 }],
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>},
  ],
};

DATA.orders.forEach((o, i) => { o.q = i + 1; });

const state = {
  productId: 1,
  step: 0,
  sel: {},
  total: 0,
  orderId: 14,
  viewOrderId: 14,
  nextOrderId: 15,
  confirmId: null,
  pickStep: null,
  queuePos: 1,
  menu: false,
};

const app = document.getElementById('app');

function product() {
  return DATA.products[state.productId];
}

function cards() {
  const map = {};
  Object.values(DATA.products).forEach((p) => {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>p.steps.forEach((s) => s.cards.forEach((c) => { map[c.id] = { card: c, step: s }; }));
  });
  return map;
}

const CARD_MAP = cards();

function fromPrice(p) {
  return p.steps
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>.filter((s) => s.required)
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>.reduce((sum, s) => sum + Math.min(...s.cards.map((c) => c.price)), 0);
}

function orderTotal() {
  return Object.entries(state.sel).reduce((sum, [id, qty]) => {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>const hit = CARD_MAP[id];
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>return hit ? sum + hit.card.price * qty : sum;
  }, 0);
}

function selectedInStep(step) {
  return step.cards.filter((c) => state.sel[c.id]);
}

function orderTotalOf(o) {
  return o.items.reduce((sum, it) => {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>const hit = CARD_MAP[it.card];
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>return hit ? sum + hit.card.price * it.qty : sum;
  }, 0);
}

function orderQtyOf(o) {
  return o.items.reduce((sum, it) => sum + it.qty, 0);
}

function orderGroups(o) {
  const p = DATA.products[o.productId];
  return p.steps
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>.map((step) => ({
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  step,
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  rows: o.items
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>.map((it) => ({ card: CARD_MAP[it.card] && CARD_MAP[it.card].card, qty: it.qty }))
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>.filter((r) => r.card && CARD_MAP[r.card.id].step === step),
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>}))
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>.filter((g) => g.rows.length);
}

const STATUS_LABEL = { new: 'В работе', done: 'Выполнен', cancelled: 'Отменён' };

function moveOrder(id, dir) {
  const list = queueList();
  const i = list.findIndex((o) => o.id === id);
  if (i < 0) return;
  const j = dir === 'up' ? i - 1 : i + 1;
  if (j < 0 || j >= list.length) return;
  const a = list[i];
  const b = list[j];
  const q = a.q;
  a.q = b.q;
  b.q = q;
}

function statusLabel(o) {
  return STATUS_LABEL[o.status] || 'В работе';
}

function queueList() {
  return DATA.orders
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>.filter((o) => o.status === 'new')
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>.sort((a, b) => a.q - b.q || a.at - b.at || a.id - b.id);
}

function queuePosition(o) {
  if (o.status !== 'new') return null;
  const i = queueList().findIndex((x) => x.id === o.id);
  return i < 0 ? null : i + 1;
}

function ordinal(n) {
  return n + '-й';
}

function topbar(opts) {
  const o = opts || {};
  const left = o.back
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>? `<button class="back-btn" data-act="back" aria-label="Назад">${CHEVRON}</button>`
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>: `<div class="brand">${CROSS(16, 'currentColor', 2.4)}<span>СобериЗаказ</span></div>`;
  return `<header class="topbar">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${left}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${o.back && o.title ? `<div class="top-title">${o.title}</div>` : ''}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><button class="icon-btn" data-act="menu" aria-label="Меню">${MENU_ICON}</button>
  </header>`;
}

function bar(inner) {
  return `<div class="bar">${inner}</div>`;
}

function productCard(p) {
  return `<a class="product" href="#product/${p.id}">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="product-media">${chartArt(p.cover)}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="product-name">${p.title}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="product-meta">от ${money(fromPrice(p))}</div>
  </a>`;
}

function renderCatalog() {
  const sections = DATA.sections.map((s) => `<section class="section">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <h2 class="section-title">${s.title}</h2>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="products">${s.products.map((id) => productCard(DATA.products[id])).join('')}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></section>`).join('');
  return topbar() + `<main class="page">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><h1>Наборы для вышивки</h1>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><p class="lede">Трекеры на год и для хобби. Собираете набор по шагам — цена складывается сама.</p>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${sections}
  </main>`;
}

function renderProduct() {
  const p = product();
  return topbar({ back: true, title: p.title }) + `<main class="page">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="hero">${chartArt(p.cover)}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="product-head">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <h1>${p.title}</h1>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="price-row">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><span class="price">от ${money(fromPrice(p))}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><span class="price-note">${p.size}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  </div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <p class="body-text">${p.desc}</p>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><dl class="specs">${p.specs.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}</dl>
  </main>` + bar(`<button class="btn" data-act="start">Собрать заказ</button>`);
}

function pickCard(c, step) {
  const qty = state.sel[c.id] || 0;
  const on = qty > 0;
  return `<div class="pick" role="button" tabindex="0" aria-pressed="${on}" data-pick="${c.id}" data-card="${c.id}">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="pick-media">${art(c.art)}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="pick-body">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="pick-name">${c.title}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="pick-price">${c.price ? money(c.price) : 'включено'}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><span class="pick-check">${CROSS(11, 'currentColor', 2.4)}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${on ? `<div class="stepper">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <button data-qty="-1" aria-label="Меньше">−</button>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <span class="qty">${qty}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <button data-qty="1" ${qty >= c.max ? 'disabled' : ''} aria-label="Больше">+</button>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></div>` : ''}
  </div>`;
}

function renderStep() {
  const p = product();
  const i = state.step;
  const st = p.steps[i];
  const total = orderTotal();
  const crosses = p.steps.map((s, k) => {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>const has = selectedInStep(s).length > 0;
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>const cls = has ? 'done' : k === i ? 'current' : '';
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>return `<span class="${cls}">${CROSS(12, 'currentColor', 2.2)}</span>`;
  }).join('');
  const canNext = !st.required || selectedInStep(st).length > 0;
  const nextLabel = i === p.steps.length - 1 ? 'К заказу' : 'Далее';
  const hint = st.mode === 'single'
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>? (st.required ? 'Выберите один вариант' : 'Выберите один вариант или пропустите шаг')
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>: 'Можно выбрать несколько';
  return topbar({ back: true, title: p.title }) + `<main class="page">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="step-head">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <h1>${st.title}</h1>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="step-meta">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><span>Шаг ${i + 1} из ${p.steps.length}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><span class="crosses" aria-hidden="true">${crosses}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  </div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="hint">${hint}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="picks">${st.cards.map((c) => pickCard(c, st)).join('')}</div>
  </main>` + bar(`
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${st.required ? '' : '<button class="skip" data-act="skip">Пропустить</button>'}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><button class="btn" data-act="next" ${canNext ? '' : 'disabled'}>${nextLabel}${total ? ' · ' + money(total) : ''}</button>
  `);
}

function legendRow(item, editable) {
  const { card, qty } = item;
  if (!editable) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>return `<div class="legend-row">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="legend-thumb">${art(card.art)}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="legend-main">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="legend-name">${card.title}</div>
