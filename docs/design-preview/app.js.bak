function renderOrder(id) {
  const o = DATA.orders.find((x) => x.id === id);
  if (!o) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>return topbar({ back: true, title: 'Заказ' }) + `<main class="page">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <h1>Заказ не найден</h1>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <p class="note"><a href="#orders">К моим заказам</a></p>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></main>`;
  }
  const p = DATA.products[o.productId];
  const cancelled = o.status === 'cancelled';
  const done = o.status === 'done';
  const groups = orderGroups(o).map((g) => `<div class="legend-group">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="legend-step"><span>${g.step.title}</span></div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${g.rows.map((r) => legendRow(r, false)).join('')}
  </div>`).join('');
  return topbar({ back: true, title: `Заказ №${o.id}` }) + `<main class="page">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><h1>Заказ №${o.id}</h1>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="order-status${cancelled ? ' red' : ''}">${statusLabel(o)} · ${o.when}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${o.status === 'new' ? `<div class="queue-line">Ваш заказ — ${ordinal(queuePosition(o))} в очереди</div>` : ''}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="legend-title">${p.title}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${groups}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="total">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <span class="total-label">Итого</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <span class="total-value">${money(orderTotalOf(o))}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${cancelled
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  ? `<div class="cancelled-note">Заказ отменён ${o.cancelledWhen || ''}. Если это ошибка — напишите в сообщество, соберём заново.</div>`
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  : done
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>? `<div class="cancelled-note">Заказ выполнен ${o.doneWhen || ''}. Если что-то не так — напишите в сообщество.</div>`
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>: `<button class="btn danger block" data-cancel="${o.id}">Отменить заказ</button>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>   <p class="note">Отмена сразу придёт владельцу. Состав сохранится в истории заказов.</p>`}
  </main>`;
}

function renderSuccess() {
  return topbar({ back: true, title: 'Заказ' }) + `<main class="page">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="done-wrap">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="done-mark">${CHECK}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <h1>Заказ №${state.orderId} отправлен</h1>
