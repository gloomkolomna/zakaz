function render() {
  const hash = location.hash.replace('#', '') || 'catalog';
  const name = hash.split('/')[0];
  if (name === 'catalog') return renderCatalog();
  if (name === 'product') return renderProduct();
  if (name === 'step') return renderStep();
  if (name === 'review') return renderReview();
  if (name === 'success') return renderSuccess();
  if (name === 'orders') return renderOrders();
  if (name === 'order') return renderOrder(state.viewOrderId);
  if (name === 'admin') return renderAdmin();
  return renderCatalog();
}

function paint(keepScroll) {
  const y = keepScroll ? window.scrollY : 0;
  app.innerHTML = render() + renderMenu() + renderConfirm() + renderSheet();
  const name = (location.hash.replace('#', '') || 'catalog').split('/')[0];
  const main = app.querySelector('main');
  if (main) main.classList.add('page-' + name);
  window.scrollTo(0, y);
}

function go(hash) {
  location.hash = hash;
}

function seedReview() {
  if (Object.keys(state.sel).length) return;
  state.sel = { c101: 1, c202: 1, c302: 1, c401: 1, c501: 1 };
}

function handlePick(id) {
  const hit = CARD_MAP[id];
  if (!hit) return;
  const { card, step } = hit;
  if (state.sel[id]) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>delete state.sel[id];
  } else {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>if (step.mode === 'single') step.cards.forEach((c) => delete state.sel[c.id]);
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>state.sel[id] = 1;
  }
  paint(true);
}

function handleQty(id, delta) {
  const current = state.sel[id] || 0;
  const next = current + delta;
  if (next <= 0) delete state.sel[id];
  else state.sel[id] = Math.min(next, CARD_MAP[id].card.max);
  paint(true);
}

function route() {
  const hash = location.hash.replace('#', '') || 'catalog';
  const [name, arg] = hash.split('/');
  if (name === 'product') state.productId = Number(arg) || 1;
  if (name === 'order') state.viewOrderId = Number(arg) || 14;
  if (name === 'step') {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>state.step = Math.max(0, Math.min(Number(arg) || 0, product().steps.length - 1));
  }
  if (name === 'review') seedReview();
  if (name === 'success' && !state.total) state.total = 3100;
  if (name === 'catalog') state.menu = false;
  if (name !== 'review') state.pickStep = null;
  paint(false);
}

app.addEventListener('click', (e) => {
  if (e.target.classList.contains('modal')) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>state.confirmId = null;
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>state.pickStep = null;
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>paint(true);
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>return;
  }
  const qtyBtn = e.target.closest('[data-qty]');
