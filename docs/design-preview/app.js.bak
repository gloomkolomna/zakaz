function renderReview() {
  const p = product();
  const groups = p.steps.map((st, idx) => {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>const rows = selectedInStep(st);
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>if (!rows.length) return '';
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>return `<div class="legend-group">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="legend-step">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><span>${st.title}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><button class="reselect" data-reselect="${idx}">Изменить</button>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  </div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  ${rows.map((c) => legendRow({ card: c, qty: state.sel[c.id] }, true)).join('')}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></div>`;
  }).join('');
  const missing = p.steps.filter((st) => st.required && !selectedInStep(st).length);
  const total = orderTotal();
  const canSubmit = Boolean(groups) && missing.length === 0;
  return topbar({ back: true, title: 'Заказ' }) + `<main class="page">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><h1>Ваш заказ</h1>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="legend-title">${p.title}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${groups || `<div class="empty">Здесь пока пусто. <a href="#step/0">Вернуться к шагам</a></div>`}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${missing.length
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  ? `<div class="empty">В шаге «${missing[0].title}» ничего не выбрано.
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <button class="link-btn" data-reselect="${p.steps.indexOf(missing[0])}">Выбрать</button></div>`
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  : ''}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${canSubmit ? `<div class="total">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <span class="total-label">Итого</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <span class="total-value">${money(total)}</span>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></div>` : ''}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><p class="note">Оплата и доставка — в переписке ВКонтакте. Напишу вам в личные сообщения после отправки.</p>
  </main>` + bar(groups
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>? `<button class="btn" data-act="submit" ${canSubmit ? '' : 'disabled'}>Отправить заказ</button>`
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>: `<a class="btn secondary" href="#step/0">Вернуться к шагам</a>`);
}

function renderSheet() {
  if (state.pickStep === null) return '';
  const p = product();
  const st = p.steps[state.pickStep];
  if (!st) return '';
  const hint = st.mode === 'single' ? 'Выберите один вариант' : 'Можно выбрать несколько';
  return `<div class="modal sheet-modal" data-sheet>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="sheet-card" role="dialog" aria-modal="true" aria-labelledby="reselect-title">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="sheet-card-head">
