    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  items: [{ card: '301', qty: 1 }, { card: '303', qty: 1 }],
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>},
