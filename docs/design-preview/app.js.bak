    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  cards: [
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>{ id: id + '03', title: 'Без рамы', price: 0, max: 5, art: { type: 'chart', cols: 18, rows: 24, seed: id * 7 + 3, palette, bg } },
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>{ id: id + '04', title: 'Дубовая рама', price: 1100, max: 5, art: { type: 'chart', cols: 18, rows: 24, seed: id * 7 + 3, palette, bg, frame: '#8b6e4e' } },
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  ],
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>},
  ];
}

