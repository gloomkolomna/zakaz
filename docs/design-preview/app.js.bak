app.addEventListener('keydown', (e) => {
  if (e.key !== 'Enter' && e.key !== ' ') return;
  const pick = e.target.closest('[data-pick]');
  if (!pick) return;
  e.preventDefault();
  handlePick(pick.dataset.pick);
});

document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape') return;
  if (state.pickStep !== null || state.confirmId) {
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>state.pickStep = null;
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>state.confirmId = null;
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>paint(true);
  }
});

window.addEventListener('hashchange', route);

if (!location.hash) location.hash = 'catalog';
route();
