    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="oc-meta">${o.when} · ${orderQtyOf(o)} поз.</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  ${o.status === 'new' ? `<div class="oc-queue">№ ${queuePosition(o)} в очереди</div>` : ''}
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  <div class="oc-sum">${money(orderTotalOf(o))}</div>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div></a>`;
  }).join('');
  return topbar({ back: true, title: 'Мои заказы' }) + `<main class="page">
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><h1>Мои заказы</h1>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}
  </main>`;
