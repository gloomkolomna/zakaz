    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  cancelSeen: false, cancelledWhen: '26 октября, 11:40',
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div>  items: [{ card: '202', qty: 1 }, { card: '204', qty: 1 }],
