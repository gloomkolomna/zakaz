function renderConfirm() {
  if (!state.confirmId) return '';
  const o = DATA.orders.find((x) => x.id === state.confirmId);
  if (!o) return '';
  return `<div class="modal" data-modal>
    <div class="orders-list">${rows || `<div class="empty">Заказов пока нет. <a href="#catalog">Собрать первый</a></div>`}</div><div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="cancel-title">
